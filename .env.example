# =========================================================
# CompanyBrain AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# =========================================================

# ---- Supabase ----
# Project URL (e.g. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Anon (public) key — used in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — used in API routes ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket name used to store uploaded training materials
SUPABASE_STORAGE_BUCKET=companybrain

# ---- Google Gemini ----
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used to answer questions as the persona(テキスト回答系)。
GEMINI_ANSWER_MODEL=gemini-2.5-pro
# Model used to transcribe uploaded training videos. Flash is fine here.
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ---- Gemini Live API (リアルタイム音声会話) ----
# 同じ GEMINI_API_KEY を使う(Live API が有効な課金プロジェクトであること)。
# キーで使えるモデル名は /api/debug/live-models で確認できる。
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voice the agent speaks with. Multi-lingual incl. Japanese.
# Options: Aoede, Charon, Fenrir, Kore, Leda, Orus, Puck, Zephyr.
GEMINI_LIVE_VOICE=Kore

# ---- プラン等級別・管理者用モデルの差し替え(任意) ----
# 未設定ならそれぞれの既定にフォールバックする。
# GEMINI_MODEL_FREE=           # プラン等級別のテキスト回答モデル
# GEMINI_MODEL_STARTER=
# GEMINI_MODEL_STANDARD=
# GEMINI_MODEL_PRO=
# GEMINI_MODEL_ENTERPRISE=
# GEMINI_MODEL_ADMIN=          # 管理者のテキスト回答モデル(既定は最上位)
# GEMINI_LIVE_MODEL_FREE=      # プラン等級別の音声モデル
# GEMINI_LIVE_MODEL_STARTER=
# GEMINI_LIVE_MODEL_BASIC=
# GEMINI_LIVE_MODEL_STANDARD=
# GEMINI_LIVE_MODEL_PRO=
# GEMINI_LIVE_MODEL_ENTERPRISE=
# GEMINI_LIVE_MODEL_ADMIN=     # 管理者の音声モデル(既定は最上位)

# ---- キオスク(展示モード) ----
# 公開ディスプレイ用のアクセスキーと、公開を許可する1ブレインのID。
# 両方を設定した時だけ /kiosk が有効になる。
# KIOSK_ACCESS_KEY=
# KIOSK_AVATAR_ID=
# キオスクの1日あたり音声上限(分)。既定は無効(展示を途中で止めない)。
# KIOSK_DAILY_VOICE_MINUTES=

# ---- 外部連携・運用(任意) ----
# Make.com / GAS などからの素材投入API(/api/ingest/*)の Bearer キー。
# 未設定なら ingest API は無効。
# INGEST_API_KEY=
# Vercel Cron の認証(vercel.json の cron から送られる)。
# CRON_SECRET=
# サーバーエラーの通知先 Webhook(Slack 等)。
# ERROR_WEBHOOK_URL=
